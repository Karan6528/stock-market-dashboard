# Copy this file to .streamlit/secrets.toml and fill in what you need.
# secrets.toml is git-ignored, so keys never reach GitHub.
# Every key is optional: the app works without any of them.

# Start in offline mode (cached/demo data only)
OFFLINE_MODE = false

# News sentiment with provider scores: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY = ""

# YouTube page: Google Cloud Console > APIs > YouTube Data API v3
YOUTUBE_API_KEY = ""

# Email for price alerts (Gmail: use an App Password, not your normal password)
SMTP_USER = ""
SMTP_PASSWORD = ""
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = 465
